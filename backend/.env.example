# Config template. `make install` copies it to .env and generates APP_SECRET.
# Never commit .env: it holds your local values and secrets.

###> symfony/framework-bundle ###
APP_ENV=dev
APP_DEBUG=1
APP_SECRET=
###< symfony/framework-bundle ###

###> symfony/routing ###
# Base URL used to generate absolute URLs outside of HTTP requests (CLI)
DEFAULT_URI=http://localhost:8000
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Matches the "database" service in compose.yaml
DATABASE_URL="mysql://app:app@database:3306/app?serverVersion=11.4.0-MariaDB&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> bug hunt ###
# PIN typed in the admin view (header X-Admin-Pin). Change it for the open day.
ADMIN_PIN=change-me
# Folder of the bug JSON files (data/bugs/ at the root of the repo)
BUGS_DIR=../data/bugs
# "dev,network" for a real game, "dev" for the dev-only fallback (10 dev bugs, no affinity).
GAME_TRACKS=dev,network
###< bug hunt ###

###> docker compose ###
# Host ports (change them if 8000 or 8081 is already taken)
APP_PORT=8000
ADMINER_PORT=8081
# Your user and group IDs (`id -u` / `id -g`) so generated files belong to you
HOST_UID=1000
HOST_GID=1000
###< docker compose ###
