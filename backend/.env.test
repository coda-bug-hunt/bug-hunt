# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

# Separate database for the tests. The "app" user can only use the "app"
# database, so the tests use the MariaDB root account (dev-only, see compose.yaml).
DATABASE_URL="mysql://root:root@database:3306/app_test?serverVersion=11.4.0-MariaDB&charset=utf8mb4"
# A small fixed pool: one dev bug per level, one network bug.
BUGS_DIR=tests/fixtures/bugs
