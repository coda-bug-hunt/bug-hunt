# Stand configuration. Copy to .env and change the secrets before the open day.
# Never commit .env. Compose reads this file for ${VAR} substitution.
# Harmless defaults also live in compose.yaml, so `docker compose up` works
# before you copy this file.

# Symfony. An empty secret refuses to boot when APP_ENV=prod.
APP_SECRET=change-me
APP_ENV=prod
APP_DEBUG=0

# PIN typed in the admin view (header X-Admin-Pin).
ADMIN_PIN=change-me

# "dev,network" for a real game, "dev" for the dev-only fallback (10 dev bugs, no affinity).
GAME_TRACKS=dev,network

# MariaDB user `app`. The root password is only for an emergency shell.
MARIADB_PASSWORD=app
MARIADB_ROOT_PASSWORD=root

# Host ports. 8080 is the QR-code address. 8000 is the API, for the Vite proxy.
# Stop the backend/ stack first: it uses 8000 too.
WEB_PORT=8080
APP_PORT=8000
